rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() &&
        (
          ('email' in request.auth.token &&
            request.auth.token.email is string &&
            request.auth.token.email.lower() == 'adiofem.99@gmail.com') ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidDay(day) {
      return day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
    }

    function isValidStartTime(timeStr) {
      return timeStr is string && timeStr.size() == 5 && timeStr.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidEndTime(timeStr) {
      return timeStr is string && timeStr.size() == 5 && timeStr.matches('^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'notificationsEnabled', 'notificationLeadMinutes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'notificationsEnabled', 'notificationLeadMinutes',
          'soundEnabled', 'showWeekends', 'activeSemester', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.notificationsEnabled is bool &&
        data.notificationLeadMinutes is number &&
        data.notificationLeadMinutes >= 0 && data.notificationLeadMinutes <= 120 &&
        (!('soundEnabled' in data) || data.soundEnabled is bool) &&
        (!('showWeekends' in data) || data.showWeekends is bool) &&
        (!('activeSemester' in data) || (data.activeSemester is string && data.activeSemester.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClassItem(data) {
      return data.keys().hasAll([
          'id', 'userId', 'visibility', 'courseCode', 'courseTitle',
          'dayOfWeek', 'startTime', 'endTime', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'visibility', 'courseCode', 'courseTitle',
          'dayOfWeek', 'startTime', 'endTime', 'location', 'instructor',
          'color', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.visibility == 'shared' &&
        data.courseCode is string && data.courseCode.size() > 0 && data.courseCode.size() <= 30 &&
        data.courseTitle is string && data.courseTitle.size() > 0 && data.courseTitle.size() <= 100 &&
        isValidDay(data.dayOfWeek) &&
        isValidStartTime(data.startTime) &&
        isValidEndTime(data.endTime) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
        (!('instructor' in data) || (data.instructor is string && data.instructor.size() <= 80)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Read-only admin lookup collection (cannot be modified from client SDK)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    // Shared Timetable Classes (Signed-in users can read; ONLY verified admin can write)
    match /classes/{classId} {
      allow get: if isVerifiedUser() && isValidId(classId) && (resource == null || resource.data.visibility == 'shared' || isAdmin());
      allow list: if isVerifiedUser() && resource.data.visibility == 'shared';
      allow create: if isAdmin() &&
                    isValidId(classId) &&
                    isValidClassItem(incoming()) &&
                    incoming().id == classId &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
                    isValidId(classId) &&
                    isValidClassItem(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'courseCode', 'courseTitle', 'dayOfWeek', 'startTime', 'endTime',
                      'location', 'instructor', 'color', 'notes', 'visibility', 'updatedAt'
                    ]);
      allow delete: if isAdmin() && isValidId(classId);
    }

    // User Preferences Documents (Strictly private to owner)
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser() &&
                    isValidId(userId) &&
                    request.auth.uid == userId &&
                    isValidUserProfile(incoming()) &&
                    incoming().id == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
                    isValidId(userId) &&
                    request.auth.uid == userId &&
                    isValidUserProfile(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'notificationsEnabled', 'notificationLeadMinutes',
                      'soundEnabled', 'showWeekends', 'activeSemester', 'updatedAt'
                    ]);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
