{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User notification and display preferences for the Engra timetable app",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User unique identifier"
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether push notifications are enabled"
        },
        "notificationLeadMinutes": {
          "type": "number",
          "description": "Minutes before class to trigger notification"
        },
        "soundEnabled": {
          "type": "boolean",
          "description": "Whether notification audio chime is enabled"
        },
        "showWeekends": {
          "type": "boolean",
          "description": "Whether Saturday and Sunday are displayed"
        },
        "activeSemester": {
          "type": "string",
          "maxLength": 64,
          "description": "Current semester name"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["id", "notificationsEnabled", "notificationLeadMinutes", "createdAt", "updatedAt"]
    },
    "ClassItem": {
      "title": "ClassItem",
      "description": "Individual lecture or class scheduled at any time of day in the shared Engra timetable",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the class"
        },
        "userId": {
          "type": "string",
          "description": "Admin creator user ID"
        },
        "visibility": {
          "type": "string",
          "enum": ["shared"],
          "description": "Shared visibility scope for all signed-in users"
        },
        "courseCode": {
          "type": "string",
          "maxLength": 30,
          "description": "Course code (e.g. CS101)"
        },
        "courseTitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Course title or subject name"
        },
        "dayOfWeek": {
          "type": "string",
          "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "description": "Day of week"
        },
        "startTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Class start time in 24h HH:mm (00:00 to 23:59)"
        },
        "endTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]|24:00$",
          "description": "Class end time in 24h HH:mm (00:00 to 24:00)"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Lecture hall or lab room"
        },
        "instructor": {
          "type": "string",
          "maxLength": 80,
          "description": "Lecturer or instructor name"
        },
        "color": {
          "type": "string",
          "maxLength": 30,
          "description": "Hex or theme color token"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional preparation notes or room access info"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["id", "userId", "visibility", "courseCode", "courseTitle", "dayOfWeek", "startTime", "endTime", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User preferences and notification settings"
    },
    "/classes/{classId}": {
      "schema": {
        "$ref": "#/entities/ClassItem"
      },
      "description": "Shared lecture class items readable by signed-in users and writable only by the verified admin"
    }
  }
}
